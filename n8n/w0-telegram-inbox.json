    {
      "parameters": {
        "jsCode": "// Kata kunci program untuk jalur W5 (bonus). Ditulis huruf besar.\nconst KATA_KUNCI = ['KJP', 'KJMU', 'KLJ', 'KPDJ', 'KAJ'];\n\nconst hasil = [];\n\nfor (const item of $input.all()) {\n  const pesan = item.json.message;\n\n  // Lewati kalau bukan pesan biasa (misalnya pesan yang diedit)\n  if (!pesan || !pesan.chat) {\n    continue;\n  }\n\n  // Lewati pesan dari grup. Bot ini hanya melayani chat pribadi.\n  if (pesan.chat.type !== 'private') {\n    continue;\n  }\n\n  const chatId = pesan.chat.id;\n  // Stiker, foto, dan sejenisnya tidak punya teks, jadi diisi kosong\n  const teks = (pesan.text || '').trim();\n  const kata = teks.split(/\\s+/);\n  const kataPertama = kata[0].toLowerCase();\n\n  let jenis = 'lainnya';\n  let kode = null;\n\n  if (kataPertama === '/start' || kataPertama.startsWith('/start@')) {\n    if (kata.length > 1 && kata[1] !== '') {\n      jenis = 'start_kode';\n      kode = kata[1].toUpperCase().slice(0, 64);\n    } else {\n      jenis = 'start_kosong';\n    }\n  } else if (KATA_KUNCI.includes(teks.toUpperCase())) {\n    jenis = 'kata_kunci';\n  }\n\n  hasil.push({\n    json: {\n      chat_id: chatId,\n      teks: teks,\n      jenis: jenis,\n      kode: kode,\n    },\n  });\n}\n\nreturn hasil;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
