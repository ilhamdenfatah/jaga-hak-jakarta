    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Data yang dikirim halaman Warga ada di dalam body\nconst masuk = $json.body || {};\n\n// 1. Rapikan data: teks kosong dianggap tidak diisi (null)\nconst data = {};\nfor (const kunci in masuk) {\n  let nilai = masuk[kunci];\n  if (typeof nilai === 'string') {\n    nilai = nilai.trim();\n    if (nilai === '') {\n      nilai = null;\n    }\n  }\n  data[kunci] = nilai;\n}\n\n// 2. Periksa kolom wajib satu per satu\nconst kolomWajib = [\n  { kunci: 'nama_pemohon', label: 'nama pemohon' },\n  { kunci: 'kelurahan', label: 'kelurahan' },\n  { kunci: 'kode_program', label: 'program' },\n  { kunci: 'kronologi', label: 'kronologi' },\n];\nlet pesan = '';\nfor (const kolom of kolomWajib) {\n  if (data[kolom.kunci] === undefined || data[kolom.kunci] === null) {\n    pesan = 'Kolom ' + kolom.label + ' belum diisi.';\n    break;\n  }\n}\n\n// 3. Periksa isian yang bentuknya harus tertentu\nif (pesan === '') {\n  if (data.sumber_data !== 'stan' && data.sumber_data !== 'uji') {\n    pesan = 'Sumber data harus stan atau uji.';\n  } else if (typeof data.ada_lansia !== 'boolean' || typeof data.ada_disabilitas !== 'boolean') {\n    pesan = 'Kolom lansia dan disabilitas harus berisi true atau false.';\n  }\n}\n\nreturn {\n  json: {\n    valid: pesan === '',\n    pesan: pesan,\n    data: data,\n  },\n};"
      },
