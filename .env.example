# Salin file ini menjadi .env lalu isi nilainya di komputer masing-masing.
# File .env tidak boleh di-push ke GitHub dan tidak boleh dikirim ke grup.

# API key milik sendiri
GROQ_API_KEY=
GEMINI_API_KEY=

# Connection string Supabase jenis Session pooler.
# Hanya PJ Jalur B dan PJ Jalur C yang menerimanya dari koordinator lewat pesan pribadi.
DATABASE_URL=

# URL webhook produksi dari n8n Cloud (workflow 1 dan workflow 2)
N8N_WEBHOOK_W1_URL=
N8N_WEBHOOK_W2_URL=

# Username bot Telegram, tanpa tanda @
# Dipakai untuk membuat QR code t.me/<username>?start=<kode>
# Token bot TIDAK ditaruh di sini. Token hanya ada di credential n8n.
TELEGRAM_BOT_USERNAME=
